APP_ENV=development
APP_DEBUG=true
APP_NAME=ESG Report Agent Service
DOCS_ENABLED=true
SECURITY_HSTS_ENABLED=false

DATABASE_URL=postgresql+asyncpg://esg:esg@postgres:5432/esg
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=.storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=esg-report
MINIO_SECURE=false

JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

OPENVIKING_ENABLED=false
OPENVIKING_BASE_URL=http://openviking:1933
OPENVIKING_API_KEY=
OPENVIKING_UPLOAD_MODE=local
OPENVIKING_RECONCILE_MAX_RETRIES=20

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=default
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.25

MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_ANCHORS=20000
MAX_DOCUMENT_TEXT_CHARS=10000000
TASK_STALE_AFTER_SECONDS=900
DOCUMENT_STALE_AFTER_SECONDS=900
